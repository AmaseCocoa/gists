#!/usr/bin/env bash
set -euo pipefail

BIN_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${BIN_DIR}/.." && pwd)"
SCRIPTS_DIR="${REPO_ROOT}/scripts"

if [[ "${1:-}" == "update" ]]; then
    echo "Updating repository..."
    git -C "${REPO_ROOT}" pull origin "$(git -C "${REPO_ROOT}" rev-parse --abbrev-ref HEAD)"
    echo "Done."
    exit 0
fi

if [[ ! -d "${SCRIPTS_DIR}" ]]; then
    echo "Error: '${SCRIPTS_DIR}' directory not found." >&2
    exit 1
fi

cd "${SCRIPTS_DIR}"

mapfile -t ALL_TOOLS < <(
    find . -maxdepth 1 -type f ! -name '.*' | sed 's|^\./||' | sort
)

if [[ ${#ALL_TOOLS[@]} -eq 0 ]]; then
    echo "No tools found in scripts/"
    exit 0
fi

get_description() {
    local tool="$1"
    local desc
    desc=$(grep -i '^# *DESCRIPTION:' "${SCRIPTS_DIR}/${tool}" | head -n 1 | sed -E 's/^# *DESCRIPTION: *//i')
    echo "${desc:-No Description}"
}

SELECTED=()

if command -v fzf >/dev/null 2>&1; then
    INITIAL_SELECTED=()
    for tool in "${ALL_TOOLS[@]}"; do
        if [[ -L "${BIN_DIR}/${tool}" ]]; then
            INITIAL_SELECTED+=("${tool}")
        fi
    done

    FZF_BIND_ARGS=()
    if [[ ${#INITIAL_SELECTED[@]} -gt 0 ]]; then
        PRESELECT_PATTERN=$(printf "%s\n" "${INITIAL_SELECTED[@]}")
        FZF_BIND_ARGS=(
            --sync
            --bind "load:select-multiple(${PRESELECT_PATTERN})+first"
        )
    fi

    while IFS= read -r line; do
        [[ -n "${line}" ]] && SELECTED+=("${line}")
    done < <(
        printf '%s\n' "${ALL_TOOLS[@]}" | fzf --multi \
            "${FZF_BIND_ARGS[@]}" \
            --header="Select tools to enable (TAB: toggle, Enter: confirm)" \
            --bind "tab:toggle+down" \
            --preview-window="wrap" \
            --preview="
                tool='{}'
                bin='${BIN_DIR}/{}'
                script='${SCRIPTS_DIR}/{}'

                if test -L \"\$bin\"; then
                    echo 'Status: [Enabled]'
                else
                    echo 'Status: [Disabled]'
                fi
                echo '----------------------------------------'
                echo -n 'Description: '
                grep -i '^# *DESCRIPTION:' \"\$script\" | head -n 1 | sed -E 's/^# *DESCRIPTION: *//i' || echo 'No Description'
            "
    )
else
    echo "fzf not found. Falling back to basic selection."
    echo "Enter numbers separated by space (e.g., 1 3):"

    for i in "${!ALL_TOOLS[@]}"; do
        status="[ ]"
        [[ -L "${BIN_DIR}/${ALL_TOOLS[$i]}" ]] && status="[x]"
        desc=$(get_description "${ALL_TOOLS[$i]}")
        echo "  $((i+1))) ${status} ${ALL_TOOLS[$i]} - ${desc}"
    done

    read -rp "Selection: " -a INDEXES
    for idx in "${INDEXES[@]}"; do
        if [[ "${idx}" =~ ^[0-9]+$ ]] && (( idx >= 1 && idx <= ${#ALL_TOOLS[@]} )); then
            SELECTED+=("${ALL_TOOLS[$((idx-1))]}")
        fi
    done
fi

echo "Updating symlinks in ${BIN_DIR}..."

declare -A IS_SELECTED
for tool in "${SELECTED[@]}"; do
    IS_SELECTED["${tool}"]=1
done

for tool in "${ALL_TOOLS[@]}"; do
    target_link="${BIN_DIR}/${tool}"
    script_path="${SCRIPTS_DIR}/${tool}"

    if [[ -n "${IS_SELECTED["${tool}"]:-}" ]]; then
        if [[ ! -x "${script_path}" ]]; then
            chmod +x "${script_path}"
        fi

        if [[ ! -L "${target_link}" ]]; then
            ln -sf "${script_path}" "${target_link}"
            echo "  + Enabled: ${tool}"
        fi
    else
        if [[ -L "${target_link}" ]]; then
            rm -f "${target_link}"
            echo "  - Disabled: ${tool}"
        fi
    fi
done

echo "Done."
