{
    "description": "gistsです",
    "script_root": "./scripts",
    "scripts": {
        "gi": {
            "type": "shell_script",
            "description": "gitignoreを自動生成するscript",
            "path": "gi"
        },
        "vpma": {
            "type": "shell_script",
            "description": "vcc://vpm/addRepo形式のurlからそのままvrc-get repo addするエイリアス",
            "path": "vpma"
        },
        "dvi": {
            "type": "shell_script",
            "description": "direnvとdevboxを同時にセットアップするだけのショートカット",
            "path": "dvi"
        },
        "cls": {
            "type": "shell_script",
            "description": "ファイルなどの場合はcat、ディレクトリの場合はlsを実行してくれるエイリアス",
            "path": "cls"
        },
        "license": {
            "type": "shell_script",
            "description": "年やgitのuser.nameとテンプレートからLICENSEを自動生成するツール",
            "path": "license"
        },
        "tmprepo": {
            "type": "shell_script",
            "description": "リポジトリを/tmpにcloneしてエディタで開くだけのツール",
            "path": "tmprepo"
        },
        "gh-repo-rm": {
            "type": "shell_script",
            "description": "GitHubのリポジトリを一括削除するツール",
            "path": "gh-repo-rm"
        }
    }
}
