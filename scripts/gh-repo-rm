#!/usr/bin/env bash

set -euo pipefail

for cmd in gh fzf jq; do
  if ! command -v "$cmd" &> /dev/null; then
    echo "Error: $cmd is not installed." >&2
    exit 1
  fi
done

USERNAME=$(gh api user --jq '.login')

echo "Fetching repositories for @${USERNAME}..."

repo_json=$(gh repo list "$USERNAME" --limit 1000 --json nameWithOwner,isEmpty,description)

initial_selections=$(echo "$repo_json" | jq -r '
  to_entries | map(select(.value.isEmpty == true) | .key) | join(",")
')

repos=$(echo "$repo_json" | jq -r '.[] | .nameWithOwner' \
  | fzf -m \
    --height=60% \
    --layout=reverse \
    --border \
    --header="[Tab] Select/Deselect / [Enter] Confirm" \
    --preview-window="right:50%:wrap" \
    --preview="echo '$repo_json' | jq -r --arg name {} '.[] | select(.nameWithOwner == \$name) | \"■ Description\\n\\n\" + (.description // \"(No description)\")'" \
    --pre-select-items="$initial_selections")

if [ -z "$repos" ]; then
  echo "Canceled."
  exit 0
fi

echo ""
echo "The following repositories will be DELETED:"
echo "----------------------------------------"
echo "$repos"
echo "----------------------------------------"

printf "Are you sure? (y/N): "
read -r answer < /dev/tty

if [[ "$answer" =~ ^[Yy]$ ]]; then
  echo "$repos" | while read -r repo; do
    echo "Deleting: $repo ..."
    gh repo delete "$repo" --yes
  done
  echo "Done."
else
  echo "Canceled."
  exit 0
fi
