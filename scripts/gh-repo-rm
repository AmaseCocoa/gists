#!/usr/bin/env bash

set -euo pipefail

for cmd in gh fzf jq; do
  if ! command -v "$cmd" &> /dev/null; then
    echo "Error: $cmd is not installed." >&2
    exit 1
  fi
done

USERNAME=$(gh api user --jq '.login')

echo "Fetching repositories for @${USERNAME}..."

repo_json=$(gh repo list "$USERNAME" --limit 1000 --json nameWithOwner,isEmpty,description)

formatted_list=$(echo "$repo_json" | jq -r '
  .[] 
  | if .isEmpty == true then "[EMPTY] " + .nameWithOwner else .nameWithOwner end
' | sort -r)

selected_items=$(echo "$formatted_list" \
  | fzf -m \
    --height=60% \
    --layout=reverse \
    --border \
    --header="[Tab] Select/Deselect / [Enter] Confirm" \
    --preview-window="right:50%:wrap" \
    --preview="
      name=\$(echo {} | sed 's/^\[EMPTY\] //')
      echo '$repo_json' | jq -r --arg name \"\$name\" '.[] | select(.nameWithOwner == \$name) | \"■ Description\\\\n\\\\n\" + (.description // \"(No description)\")'
    " \
    --bind "load:execute-silent(echo '[EMPTY]')+change-query+select-all+clear-query")

if [ -z "$selected_items" ]; then
  echo "Canceled."
  exit 0
fi

repos=$(echo "$selected_items" | sed 's/^\[EMPTY\] //')

echo ""
echo "The following repositories will be DELETED:"
echo "----------------------------------------"
echo "$repos"
echo "----------------------------------------"

printf "Are you sure? (y/N): "
read -r answer < /dev/tty

if [[ "$answer" =~ ^[Yy]$ ]]; then
  echo "$repos" | while read -r repo; do
    echo "Deleting: $repo ..."
    gh repo delete "$repo" --yes
  done
  echo "Done."
else
  echo "Canceled."
  exit 0
fi
